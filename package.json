{
  "name": "exponential-sdk",
  "version": "1.31.1",
  "description": "The official TypeScript SDK for Exponential, the open-source workspace for goals, OKRs, projects and AI agents",
  "keywords": [
    "exponential",
    "sdk",
    "typescript",
    "project-management",
    "okr",
    "tasks",
    "ai-agents",
    "mcp",
    "trpc"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0-rc.446",
    "conf": "^13.0.1",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exponential-im/exponential-sdk.git"
  },
  "homepage": "https://www.exponential.im/features/integrations/sdk",
  "bugs": {
    "url": "https://github.com/exponential-im/exponential-sdk/issues"
  }
}
